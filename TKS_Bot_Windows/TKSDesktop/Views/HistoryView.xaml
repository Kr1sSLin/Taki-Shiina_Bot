<UserControl x:Class="TKSDesktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TKSDesktop.Views"
             Background="Transparent">

    <!--
        History & memory page (FR-W-HIS-1..5).

        * Bot notifications list with unread count and mark-all-read (FR-W-HIS-1).
        * User facts list, newest first (FR-W-HIS-2), filterable in place (FR-W-HIS-3).
        * Facts are READ-ONLY (FR-W-HIS-4): the backend has no edit/delete endpoint, so
          no local delete affordance is offered - a local-only delete would fake
          server-side consistency.
        * This page must be REACHABLE, not merely implemented (FR-W-HIS-5): the main
          window navigation and the tray menu both route here.

        Both sections are shown side by side so the page needs no tab state of its own.
    -->

    <Grid Margin="{DynamicResource Tks.Space.Lg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Tks.Text.Title}" Text="{Binding TitleText}" />
                <Border Style="{StaticResource Tks.Badge}" Margin="8,0,0,0"
                        Visibility="{Binding HasUnread, Converter={StaticResource Tks.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Tks.Text.Caption}" Text="{Binding UnreadText}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Tks.Button.Ghost}"
                        Content="{Binding MarkAllReadText}"
                        Command="{Binding MarkAllReadCommand}"
                        Visibility="{Binding HasUnread, Converter={StaticResource Tks.BoolToVisibility}}" />
                <Button Style="{StaticResource Tks.Button.Ghost}"
                        Content="{Binding CloseText}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ============ Two panes: notifications | facts ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Notifications -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Tks.Text.Body}"
                           Margin="0,0,0,8"
                           Text="{Binding NotificationsTitle}" />

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Tks.Text.Caption}"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsNotificationEmpty, Converter={StaticResource Tks.BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Style="{StaticResource Tks.ScrollViewer}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Tks.Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Tks.Text.Body}" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Tks.Text.Caption}" Text="{Binding ErrorCode}" />
                                        <TextBlock Style="{StaticResource Tks.Text.Caption}"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding TimeText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Facts (read-only) -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Tks.Text.Body}"
                           Margin="0,0,0,8"
                           Text="{Binding FactsTitle}" />

                <TextBox DockPanel.Dock="Top" Style="{StaticResource Tks.TextBox.Base}"
                         Margin="0,0,0,4"
                         Text="{Binding FactSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding FactSearchPlaceholder}" />

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Tks.Text.Caption}"
                           Margin="0,0,0,8"
                           Text="{Binding FactsReadonlyText}" TextWrapping="Wrap" />

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Tks.Text.Caption}"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsFactEmpty, Converter={StaticResource Tks.BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Facts}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Style="{StaticResource Tks.ScrollViewer}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Tks.Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Tks.Text.Body}" Text="{Binding Fact}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Tks.Text.Caption}"
                                               Margin="0,4,0,0"
                                               Text="{Binding TimeText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
