<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:TKSDesktop.Views.Converters"
                    xmlns:views="clr-namespace:TKSDesktop.Views">

    <!--
        Shared control styles (PRD FR-W-UI-3/5/11, FR-W-CHAT-14, FR-W-PT-2,
        FR-W-INT-4, FR-W-HIS-1) plus the mandatory visible keyboard focus state
        (`Tks.FocusVisual`) required by the accessibility item: every focusable
        control must be reachable with Tab and show a visible focus ring.

        All copy shown by these styles comes from bindings supplied by the ViewModels
        (which read App.I18n) : no literal UI text lives here.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/TKSDesktop;component/Resources/Themes/DesignTokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/TKSDesktop;component/Resources/Themes/LiquidGlass.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================== Converters (shared instances) ===================== -->

    <converters:TimeFormat x:Key="Tks.TimeFormat" />
    <converters:BoolToVisibilityConverter x:Key="Tks.BoolToVisibility" />
    <converters:InverseBoolConverter x:Key="Tks.InverseBool" />
    <converters:NullToVisibilityConverter x:Key="Tks.NullToVisibility" />
    <converters:LevelAccentBrushConverter x:Key="Tks.LevelAccent" />
    <views:PlaceholderImageConverter x:Key="Tks.AssetPlaceholder" />

    <!-- ===================== Accessibility: visible focus ===================== -->

    <Style x:Key="Tks.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource Tks.Brush.Focus}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource Tks.Radius.Small}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="Tks.Brush.Transparent" Color="Transparent" />

    <!-- ===================== Text ===================== -->

    <Style x:Key="Tks.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Tks.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Tks.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Tks.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Tks.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Tks.Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Tks.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ===================== Buttons ===================== -->

    <Style x:Key="Tks.Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Tks.Radius.Medium}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Disabled state must be visible, never silent (NFR-W-8). -->
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tks.Brush.Focus}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tks.Button.Primary" TargetType="Button" BasedOn="{StaticResource Tks.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="Tks.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Tks.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Tks.Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Tks.Brush.Transparent}" />
    </Style>

    <Style x:Key="Tks.Button.Danger" TargetType="Button" BasedOn="{StaticResource Tks.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Tks.Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.Danger}" />
    </Style>

    <!-- Toolbar icon button (icon text is supplied by the owner view, never hardcoded here). -->
    <Style x:Key="Tks.Button.Toolbar" TargetType="Button" BasedOn="{StaticResource Tks.Button.Ghost}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Tks.Style.ReferenceComposer" TargetType="Border" BasedOn="{StaticResource Tks.Style.GlassCapsule}">
        <Setter Property="CornerRadius" Value="39" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.ComposerSurface}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(views:VisualPreferences.UseOpaqueFallback), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#FF303037" />
                            <GradientStop Offset="1" Color="#FF101016" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Circular glass controls used by the reference composer. -->
    <Style x:Key="Tks.Button.ComposerIcon" TargetType="Button" BasedOn="{StaticResource Tks.Button.Base}">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.ComposerButton}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.ComposerIcon}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="25">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.62" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tks.Brush.Focus}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tks.Button.ComposerSend" TargetType="Button" BasedOn="{StaticResource Tks.Button.ComposerIcon}">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.ComposerSend}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="Tks.Button.EmojiGlyph" TargetType="Button" BasedOn="{StaticResource Tks.Button.ComposerIcon}">
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ===================== Inputs ===================== -->

    <Style x:Key="Tks.TextBox.Base" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Tks.Radius.Medium}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tks.Brush.Focus}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tks.TextBox.Multiline" TargetType="TextBox" BasedOn="{StaticResource Tks.TextBox.Base}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="MaxHeight" Value="180" />
    </Style>

    <Style x:Key="Tks.TextBox.Composer" TargetType="TextBox" BasedOn="{StaticResource Tks.TextBox.Multiline}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.ComposerText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Tks.Brush.ComposerText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,8" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="MaxHeight" Value="128" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tks.PasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
    </Style>

    <Style x:Key="Tks.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
    </Style>

    <Style x:Key="Tks.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
    </Style>

    <Style x:Key="Tks.RadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Tks.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
    </Style>

    <!-- ===================== Surfaces ===================== -->

    <Style x:Key="Tks.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Tks.Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Tks.Space.Md}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Tks.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.AccentSoft}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Tks.Radius.Capsule}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Gift / interaction badge attached to the shared bubble template (FR-W-INT-6). -->
    <Style x:Key="Tks.Badge.Interaction" TargetType="Border" BasedOn="{StaticResource Tks.Badge}">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.AccentSoft}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- Day separator line (C-5): never rendered as an ordinary bubble. -->
    <Style x:Key="Tks.Separator.Day" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,10" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Lists ===================== -->

    <Style x:Key="Tks.List.Item" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Tks.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.TextPrimary}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{StaticResource Tks.Brush.Transparent}"
                            BorderBrush="{StaticResource Tks.Brush.Transparent}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Tks.Radius.Small}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Tks.Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Tks.Brush.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tks.Brush.Focus}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tks.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Tks.Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Tks.List.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
    </Style>

    <!-- ===================== Progress / meters ===================== -->

    <Style x:Key="Tks.ProgressBar.Level" TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Tks.Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Level badge (programmatic fallback) ===================== -->

    <Style x:Key="Tks.PandaBadge" TargetType="views:PandaBadge">
        <Setter Property="Diameter" Value="72" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:PandaBadge">
                    <Grid Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}">
                        <Ellipse>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#33FFFFFF" />
                                    <GradientStop Offset="1" Color="#22000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Stroke="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                 StrokeThickness="3" />
                        <TextBlock x:Name="BadgeGlyph" HorizontalAlignment="Center" Visibility="Collapsed"
                                   VerticalAlignment="Center"
                                   FontSize="{TemplateBinding FontSize}"
                                   Text="{Binding Glyph, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Image x:Name="BadgeArtwork" Source="{TemplateBinding Artwork}" Stretch="Uniform" Margin="4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Artwork" Value="{x:Null}">
                            <Setter TargetName="BadgeArtwork" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BadgeGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Scroll viewer ===================== -->

    <Style x:Key="Tks.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{StaticResource Tks.Brush.Transparent}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tks.FocusVisual}" />
    </Style>

</ResourceDictionary>
