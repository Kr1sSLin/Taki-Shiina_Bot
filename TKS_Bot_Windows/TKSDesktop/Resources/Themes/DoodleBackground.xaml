<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Linux visual.tsx silhouettes; vector coordinates remain crisp at every DPI. -->
    <PathGeometry x:Key="Tks.Doodle.Star" Figures="M12,3.5 L14.6,9.4 21,10 16.2,14.3 17.6,20.6 12,17.3 6.4,20.6 7.8,14.3 3,10 9.4,9.4 Z" />
    <PathGeometry x:Key="Tks.Doodle.Cloud" Figures="M7,17 L16.5,17 A4,4 0 0 0 16.8,9 A5.5,5.5 0 0 0 6.4,10.6 A3.4,3.4 0 0 0 7,17 Z" />
    <PathGeometry x:Key="Tks.Doodle.Lightning" Figures="M13.5,2.5 L5.5,13.5 10.5,13.5 9.5,21.5 17.5,10.5 12.5,10.5 Z" />
    <PathGeometry x:Key="Tks.Doodle.Heart" Figures="M12,20 C12,20 4.5,15.4 4.5,10.6 A4.1,4.1 0 0 1 12,8 A4.1,4.1 0 0 1 19.5,10.6 C19.5,15.4 12,20 12,20 Z" />
    <PathGeometry x:Key="Tks.Doodle.Circle" Figures="M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12" />
    <PathGeometry x:Key="Tks.Doodle.Moon" Figures="M19,14.5 A7.5,7.5 0 0 1 9.5,5 A7.5,7.5 0 1 0 19,14.5 Z" />
    <PathGeometry x:Key="Tks.Doodle.Smile" Figures="M3.5,12 A8.5,8.5 0 1 1 20.5,12 A8.5,8.5 0 1 1 3.5,12 M8.5,10.5 L8.6,10.5 M15.5,10.5 L15.6,10.5 M8.5,14.5 C9.8,16.1 14.2,16.1 15.5,14.5" />
    <PathGeometry x:Key="Tks.Doodle.Flower" Figures="M9.6,12 A2.4,2.4 0 1 1 14.4,12 A2.4,2.4 0 1 1 9.6,12 M12,9.6 C12,6.6 13,5 12,3.6 C11,5 12,6.6 12,9.6 Z M12,14.4 C12,17.4 13,19 12,20.4 C11,19 12,17.4 12,14.4 Z M9.6,12 C6.6,12 5,11 3.6,12 C5,13 6.6,12 9.6,12 Z M14.4,12 C17.4,12 19,11 20.4,12 C19,13 17.4,12 14.4,12 Z" />
    <Pen x:Key="Tks.Doodle.Pen" Brush="{DynamicResource Tks.Brush.Doodle}" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <DrawingBrush x:Key="Tks.Brush.DoodleTile" TileMode="Tile" Viewport="0,0,256,128" ViewportUnits="Absolute"
                  Viewbox="0,0,256,128" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <DrawingGroup Transform="1.1,0,0,1.1,12,12"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Star}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="1.3,0,0,1.3,72,24"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Cloud}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="1,0,0,1,142,8"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Lightning}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="1.2,0,0,1.2,210,28"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Heart}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="0.8,0,0,0.8,36,83"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Circle}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="1.1,0,0,1.1,102,76"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Moon}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="1,0,0,1,167,90"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Smile}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
                <DrawingGroup Transform="1.2,0,0,1.2,221,76"><GeometryDrawing Geometry="{StaticResource Tks.Doodle.Flower}" Pen="{StaticResource Tks.Doodle.Pen}" /></DrawingGroup>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
