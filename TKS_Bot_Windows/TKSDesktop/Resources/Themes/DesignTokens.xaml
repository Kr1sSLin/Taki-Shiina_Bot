<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Design tokens (PRD FR-W-UI-1/3/4/5/11, FR-W-UI-9).
        One file carries BOTH palettes:
          * `Tks.Light.<Name>` and `Tks.Dark.<Name>` hold raw colours.
          * `Tks.Brush.<Name>` holds the brush actually consumed by styles.
        Views/ThemeApplier rewrites every `Tks.Brush.<Name>` from the matching
        `Tks.Light.<Name>` / `Tks.Dark.<Name>` pair, so switching the theme never
        needs a second file and no colour is duplicated outside this file.
    -->

    <!-- ===================== Shared metrics ===================== -->

    <CornerRadius x:Key="Tks.Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Tks.Radius.Medium">10</CornerRadius>
    <CornerRadius x:Key="Tks.Radius.Large">16</CornerRadius>
    <CornerRadius x:Key="Tks.Radius.Capsule">999</CornerRadius>

    <Thickness x:Key="Tks.Space.Xs">4</Thickness>
    <Thickness x:Key="Tks.Space.Sm">8</Thickness>
    <Thickness x:Key="Tks.Space.Md">12</Thickness>
    <Thickness x:Key="Tks.Space.Lg">16</Thickness>
    <Thickness x:Key="Tks.Space.Xl">24</Thickness>

    <sys:Double x:Key="Tks.Font.Caption">11</sys:Double>
    <sys:Double x:Key="Tks.Font.Body">13</sys:Double>
    <sys:Double x:Key="Tks.Font.Title">16</sys:Double>
    <sys:Double x:Key="Tks.Font.Display">22</sys:Double>

    <sys:Double x:Key="Tks.Window.MinWidth">520</sys:Double>
    <sys:Double x:Key="Tks.Window.MinHeight">640</sys:Double>

    <!-- Reveal animation duration (FR-W-UI-4: about 400 ms). -->
    <Duration x:Key="Tks.Duration.ThemeReveal">0:0:0.4</Duration>

    <FontFamily x:Key="Tks.FontFamily">Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>

    <!-- ===================== Light palette colours ===================== -->

    <Color x:Key="Tks.Light.Background">#FFF5F6F8</Color>
    <Color x:Key="Tks.Light.Surface">#FFFFFFFF</Color>
    <Color x:Key="Tks.Light.SurfaceAlt">#FFF0F2F5</Color>
    <Color x:Key="Tks.Light.Border">#FFDCE0E6</Color>
    <Color x:Key="Tks.Light.TextPrimary">#FF1B1F24</Color>
    <Color x:Key="Tks.Light.TextSecondary">#FF5A6472</Color>
    <Color x:Key="Tks.Light.Accent">#FF37A65C</Color>
    <Color x:Key="Tks.Light.AccentSoft">#3337A65C</Color>
    <Color x:Key="Tks.Light.BubbleUser">#FFDCEFD8</Color>
    <Color x:Key="Tks.Light.BubbleBot">#FFFFFFFF</Color>
    <Color x:Key="Tks.Light.BubbleFailed">#FFFDE7E6</Color>
    <Color x:Key="Tks.Light.Danger">#FFD64545</Color>
    <Color x:Key="Tks.Light.Gain">#FF2E9E5B</Color>
    <Color x:Key="Tks.Light.Loss">#FFC2413C</Color>
    <Color x:Key="Tks.Light.Focus">#FF2C5A8C</Color>
    <Color x:Key="Tks.Light.Scrim">#66000000</Color>
    <Color x:Key="Tks.Light.GlassTint">#CCFFFFFF</Color>
    <Color x:Key="Tks.Light.OpaqueFrom">#FFFDFDFE</Color>
    <Color x:Key="Tks.Light.OpaqueTo">#FFE7EAEF</Color>
    <Color x:Key="Tks.Light.Doodle">#1A1B1F24</Color>

    <!-- ===================== Dark palette colours ===================== -->

    <Color x:Key="Tks.Dark.Background">#FF0F1218</Color>
    <Color x:Key="Tks.Dark.Surface">#FF171B22</Color>
    <Color x:Key="Tks.Dark.SurfaceAlt">#FF1F242D</Color>
    <Color x:Key="Tks.Dark.Border">#FF2C333E</Color>
    <Color x:Key="Tks.Dark.TextPrimary">#FFE9EDF2</Color>
    <Color x:Key="Tks.Dark.TextSecondary">#FF9AA5B4</Color>
    <Color x:Key="Tks.Dark.Accent">#FF7A4FBF</Color>
    <Color x:Key="Tks.Dark.AccentSoft">#447A4FBF</Color>
    <Color x:Key="Tks.Dark.BubbleUser">#FF24313A</Color>
    <Color x:Key="Tks.Dark.BubbleBot">#FF1B2028</Color>
    <Color x:Key="Tks.Dark.BubbleFailed">#FF3A2325</Color>
    <Color x:Key="Tks.Dark.Danger">#FFFF8079</Color>
    <Color x:Key="Tks.Dark.Gain">#FF6BD08A</Color>
    <Color x:Key="Tks.Dark.Loss">#FFFF8A82</Color>
    <Color x:Key="Tks.Dark.Focus">#FF9AC7FF</Color>
    <Color x:Key="Tks.Dark.Scrim">#99000000</Color>
    <Color x:Key="Tks.Dark.GlassTint">#B3171B22</Color>
    <Color x:Key="Tks.Dark.OpaqueFrom">#FF14181F</Color>
    <Color x:Key="Tks.Dark.OpaqueTo">#FF0B0E13</Color>
    <Color x:Key="Tks.Dark.Doodle">#33E9EDF2</Color>

    <!-- ===================== Brushes (rewritten on theme switch) ===================== -->

    <SolidColorBrush x:Key="Tks.Brush.Background" Color="{StaticResource Tks.Light.Background}" />
    <SolidColorBrush x:Key="Tks.Brush.Surface" Color="{StaticResource Tks.Light.Surface}" />
    <SolidColorBrush x:Key="Tks.Brush.SurfaceAlt" Color="{StaticResource Tks.Light.SurfaceAlt}" />
    <SolidColorBrush x:Key="Tks.Brush.Border" Color="{StaticResource Tks.Light.Border}" />
    <SolidColorBrush x:Key="Tks.Brush.TextPrimary" Color="{StaticResource Tks.Light.TextPrimary}" />
    <SolidColorBrush x:Key="Tks.Brush.TextSecondary" Color="{StaticResource Tks.Light.TextSecondary}" />
    <SolidColorBrush x:Key="Tks.Brush.Accent" Color="{StaticResource Tks.Light.Accent}" />
    <SolidColorBrush x:Key="Tks.Brush.AccentSoft" Color="{StaticResource Tks.Light.AccentSoft}" />
    <SolidColorBrush x:Key="Tks.Brush.BubbleUser" Color="{StaticResource Tks.Light.BubbleUser}" />
    <SolidColorBrush x:Key="Tks.Brush.BubbleBot" Color="{StaticResource Tks.Light.BubbleBot}" />
    <SolidColorBrush x:Key="Tks.Brush.BubbleFailed" Color="{StaticResource Tks.Light.BubbleFailed}" />
    <SolidColorBrush x:Key="Tks.Brush.Danger" Color="{StaticResource Tks.Light.Danger}" />
    <SolidColorBrush x:Key="Tks.Brush.Gain" Color="{StaticResource Tks.Light.Gain}" />
    <SolidColorBrush x:Key="Tks.Brush.Loss" Color="{StaticResource Tks.Light.Loss}" />
    <SolidColorBrush x:Key="Tks.Brush.Focus" Color="{StaticResource Tks.Light.Focus}" />
    <SolidColorBrush x:Key="Tks.Brush.Scrim" Color="{StaticResource Tks.Light.Scrim}" />
    <SolidColorBrush x:Key="Tks.Brush.GlassTint" Color="{StaticResource Tks.Light.GlassTint}" />
    <SolidColorBrush x:Key="Tks.Brush.Doodle" Color="{StaticResource Tks.Light.Doodle}" />

    <LinearGradientBrush x:Key="Tks.Brush.OpaqueFallback"
                         StartPoint="0,0"
                         EndPoint="1,1"
                         ColorInterpolationMode="ScRgbLinearInterpolation">
        <GradientStop Offset="0" Color="{StaticResource Tks.Light.OpaqueFrom}" />
        <GradientStop Offset="1" Color="{StaticResource Tks.Light.OpaqueTo}" />
    </LinearGradientBrush>

</ResourceDictionary>
