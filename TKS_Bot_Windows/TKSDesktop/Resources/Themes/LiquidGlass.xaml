<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TKSDesktop.Views">

    <!--
        Liquid glass surfaces (PRD FR-W-UI-3, FR-W-UI-11).

        * `Tks.Style.GlassPanel` is the frosted layer used when the system window
          blur (DWM) is available.
        * `Tks.Style.OpaquePanel` is the REQUIRED opaque gradient fallback: when
          IWindowChrome.IsSystemBlurAvailable is false (RDP session, composition
          disabled) the shell must switch to this style and must NOT keep any
          transparency or blur animation.
        * Both styles read their colours from `DesignTokens.xaml` via DynamicResource
          so a light/dark switch needs no second copy of the palette.
        * `Tks.Storyboard.GlassSheen` is the sheen animation. The View layer starts it
          only when IWindowChrome.IsAnimationReduced is false (FR-W-UI-11); reduced
          animation means the storyboard is never begun and the fallback style is used.
    -->

    <Style x:Key="Tks.Style.GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.GlassSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1.25" />
        <Setter Property="CornerRadius" Value="{DynamicResource Tks.Radius.Large}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24"
                                  Direction="270"
                                  Opacity="0.24"
                                  ShadowDepth="5"
                                  Color="#000000" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:VisualPreferences.UseOpaqueFallback), RelativeSource={RelativeSource Self}}" Value="True">
                <!-- Degradation: no transparency, no blur, opaque gradient only. -->
                <Setter Property="Background" Value="{DynamicResource Tks.Brush.OpaqueFallback}" />
                <Setter Property="Effect" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Opaque degradation style: used when blur is unavailable (FR-W-UI-3). -->
    <Style x:Key="Tks.Style.OpaquePanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tks.Brush.OpaqueFallback}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tks.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Tks.Radius.Large}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Capsule surface used by the composer / top status bar. -->
    <Style x:Key="Tks.Style.GlassCapsule" TargetType="Border" BasedOn="{StaticResource Tks.Style.GlassPanel}">
        <Setter Property="CornerRadius" Value="{DynamicResource Tks.Radius.Capsule}" />
    </Style>

    <!-- Sheen animation (about 1.6 s, slow and low contrast). -->
    <Storyboard x:Key="Tks.Storyboard.GlassSheen" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.86"
                         To="1.0"
                         Duration="0:0:1.6" />
    </Storyboard>

</ResourceDictionary>
