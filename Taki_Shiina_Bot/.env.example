# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id_here

# AI API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Weather API
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Location Settings (Latitude and Longitude)
MY_LAT=0.0
MY_LON=0.0

# Monitor Bot (Optional)
MONITOR_BOT_TOKEN=your_monitor_bot_token_here

# HTTP API Configuration
# Required and must be non-empty, otherwise http_api service startup will fail.
# 生产环境建议使用反向代理，服务仅绑定 127.0.0.1
BOT_HTTP_TOKEN=your_http_api_token_here
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8000

# WebSocket API Configuration
# Required and must be non-empty, otherwise ws_api service startup will fail.
# 生产环境建议使用反向代理，服务仅绑定 127.0.0.1
BOT_WS_TOKEN=your_ws_api_token_here
BOT_WS_HOST=127.0.0.1
BOT_WS_PORT=8001

# Auth Configuration (required for login/refresh + JWT)
# 推荐使用 AUTH_PASSWORD_HASH + AUTH_PASSWORD_SALT（PBKDF2-SHA256）
AUTH_USERNAME=your_admin_username
AUTH_USER_ID=your_user_id_optional
AUTH_PASSWORD_HASH=your_password_hash
AUTH_PASSWORD_SALT=your_password_salt
# 开发场景可使用明文（将覆盖 hash 校验）
# AUTH_PASSWORD=plain_password_for_dev
AUTH_JWT_SECRET=your_jwt_secret
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_MAX_DEVICES=4

# Data encryption (required for chat/memory storage)
# 32-byte key in base64 or hex. Example (base64):
# DATA_ENC_KEY=ZGVtby1rZXktc2hvdWxkLWJlLXNlY3VyZS0xMjM0NTY3ODkw
DATA_ENC_KEY=
# Auto-migrate existing plaintext json into encrypted format on read
DATA_AUTO_MIGRATE=1
# Backup plaintext before migration
DATA_BACKUP_ON_MIGRATE=1

# Optional device allowlist (max 4). When set, deviceId must be in allowlist.
# Format:
# 1) deviceId:token
# 2) userId:deviceId:token  (for future multi-user expansion)
# Example:
# BOT_DEVICE_TOKENS=android1:tokenA,android2:tokenB,android3:tokenC,windows1:tokenD
BOT_DEVICE_TOKENS=
