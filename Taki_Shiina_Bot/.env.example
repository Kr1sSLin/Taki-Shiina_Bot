# ===== AI 服务 =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ===== 天气（和风天气 QWeather 新版平台） =====
# 控制台 -> 开发配置 -> API Host，形如 abcxyz.qweatherapi.com（不含 https://）
QWEATHER_API_HOST=your_api_host_here
QWEATHER_API_KEY=your_qweather_api_key_here
# 城市未设置时用于经纬度回退
MY_LAT=0.0
MY_LON=0.0

# ===== HTTP / WebSocket API（必填，否则对应服务无法启动） =====
BOT_HTTP_TOKEN=your_http_api_token_here
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8000
BOT_WS_TOKEN=your_ws_api_token_here
BOT_WS_HOST=127.0.0.1
BOT_WS_PORT=8001

# ===== 推荐：统一 HTTP / WebSocket / 认证入口 =====
BOT_UNIFIED_HOST=127.0.0.1
BOT_UNIFIED_PORT=8000

# 运行时数据目录；留空沿用后端源码目录。切换前请迁移既有数据并备份。
BOT_DATA_DIR=

# ===== 认证（JWT） =====
# 推荐 PBKDF2-SHA256：AUTH_PASSWORD_HASH + AUTH_PASSWORD_SALT
# 开发场景可使用明文 AUTH_PASSWORD（将覆盖 hash 校验）
AUTH_USERNAME=your_admin_username
AUTH_USER_ID=your_user_id_optional
AUTH_PASSWORD=your_password_or_hash_salt
# AUTH_PASSWORD_HASH=your_password_hash
# AUTH_PASSWORD_SALT=your_password_salt
AUTH_JWT_SECRET=your_jwt_secret
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_MAX_DEVICES=0

# 可选设备白名单（设置了才生效，格式 deviceId:token）
# BOT_DEVICE_TOKENS=android1:tokenA,android2:tokenB
# 管理接口独立口令；未设置时普通服务仍可启动，但所有 /api/v1/admin/** 返回 403
# 请求须同时携带普通 Authorization 与 X-Admin-Token。
ADMIN_API_TOKEN=

# ===== 数据加密（聊天/记忆落盘必填，32 字节 key，base64 或 hex） =====
# 例（base64）：DATA_ENC_KEY=ZGVtby1rZXktc2hvdWxkLWJlLXNlY3VyZS0xMjM0NTY3ODkw
DATA_ENC_KEY=
DATA_AUTO_MIGRATE=1
DATA_BACKUP_ON_MIGRATE=1
# 时间线文件锁等待上限（秒）；超时映射为 HTTP 503 / WS SERVICE_UNAVAILABLE
TIMELINE_LOCK_TIMEOUT_SECONDS=10

# ===== 应用/监控 =====
APP_USER_ID=default-user
MONITOR_BOT_TOKEN=your_monitor_bot_token_here
FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here
DEBUG_REPLY_TRACE=0

# ===== 图片识别限制 =====
VISION_MAX_IMAGE_MB=20
VISION_MAX_IMAGE_COUNT=3
VISION_ALLOWED_MIME=image/jpeg,image/png

# ===== 互动积分 / 等级体系 =====
# 自然日判定时区（PRD FR-10 / EDGE-3：以服务器/业务时区为准，不做设备时区适配）
# 项目现有定时任务统一使用北京时间，故默认 8（UTC+8）
BIZ_TZ_OFFSET_HOURS=8
# 互动物品 / Prompt 模板 / 等级阈值 / 积分规则 / 重试策略
# 均在 config/gamification_config.json 中配置（首次启动自动生成），
# 也可通过 /api/v1/admin/gamification-config 读写，改完即时生效、无需发版。
#
# 测试/运维接口开关（生产安全默认关闭）：/api/v1/admin/points/adjust（改积分）、
# /api/v1/admin/progress/backfill（构造连续天数）、/api/v1/admin/progress/reset（重置进度）。
# 仅在隔离的本地/测试环境临时设为 1，验证结束后立即恢复为 0。
ENABLE_ADMIN_TEST_API=0
