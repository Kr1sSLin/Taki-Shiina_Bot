From: KrisSLin <“KrisSLin@Dev.com>
Date: Sun, 18 Oct 2026 14:04:56 +0800
Subject: [PATCH] Restore full chat history in Android client

---
 TKS_Bot_Android/app/build.gradle.kts          |  4 ++
 .../app/src/debug/res/values/strings.xml      |  3 ++
 .../feature/chat/ChatRoute.kt                 | 46 +++++++++++++------
 .../feature/chat/ChatViewModel.kt             |  2 +-
 4 files changed, 41 insertions(+), 14 deletions(-)
 create mode 100644 TKS_Bot_Android/app/src/debug/res/values/strings.xml

diff --git a/TKS_Bot_Android/app/build.gradle.kts b/TKS_Bot_Android/app/build.gradle.kts
index dd0b560..a48f290 100644
--- a/TKS_Bot_Android/app/build.gradle.kts
+++ b/TKS_Bot_Android/app/build.gradle.kts
@@ -49,6 +49,10 @@ android {
     }
 
     buildTypes {
+        debug {
+            applicationIdSuffix = ".recovery"
+            versionNameSuffix = "-recovery"
+        }
         release {
             isMinifyEnabled = false
             // 有密钥才挂签名；否则产出 app-release-unsigned.apk
diff --git a/TKS_Bot_Android/app/src/debug/res/values/strings.xml b/TKS_Bot_Android/app/src/debug/res/values/strings.xml
new file mode 100644
index 0000000..09acf1b
--- /dev/null
+++ b/TKS_Bot_Android/app/src/debug/res/values/strings.xml
@@ -0,0 +1,3 @@
+<resources>
+    <string name="app_name">Taki Shiina 恢复版</string>
+</resources>
diff --git a/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatRoute.kt b/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatRoute.kt
index 69c2654..063fea0 100644
--- a/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatRoute.kt
+++ b/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatRoute.kt
@@ -62,6 +62,8 @@ import androidx.compose.runtime.collectAsState
 import androidx.compose.runtime.getValue
 import androidx.compose.runtime.mutableStateOf
 import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.snapshotFlow
 import androidx.compose.runtime.setValue
 import androidx.compose.ui.Alignment
 import androidx.compose.ui.Modifier
@@ -108,6 +110,8 @@ import com.krisslin.androidaiassistant.feature.interaction.InteractionEntry
 import java.text.SimpleDateFormat
 import java.util.Date
 import java.util.Locale
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.flow.first
 import kotlin.math.roundToInt
 
 @OptIn(ExperimentalMaterial3Api::class)
@@ -124,6 +128,7 @@ fun ChatRoute(
     val state by viewModel.uiState.collectAsState()
     val snackbarHostState = remember { SnackbarHostState() }
     val listState = rememberLazyListState()
+    val scrollScope = rememberCoroutineScope()
     var showImagePreview by remember { mutableStateOf<String?>(null) }
     var messageMenuTargetId by remember { mutableStateOf<String?>(null) }
     var showAttachMenu by remember { mutableStateOf(false) }
@@ -253,26 +258,25 @@ fun ChatRoute(
         fabHint.animateTo(0f, tween(420, easing = FastOutSlowInEasing))
     }
 
-    var initialScrollSkipped by remember { mutableStateOf(false) }
+    var previousMessageCount by remember { mutableStateOf(0) }
 
     LaunchedEffect(state.messages.size) {
-        if (!initialScrollSkipped) {
-            initialScrollSkipped = true
-            return@LaunchedEffect
-        }
-        if (state.messages.isNotEmpty()) {
-            listState.animateScrollToItem(state.messages.size - 1)
+        val nearLatest = previousMessageCount == 0 ||
+            (listState.layoutInfo.visibleItemsInfo.lastOrNull()?.index ?: -1) >= previousMessageCount - 3
+        previousMessageCount = state.messages.size
+        if (state.messages.isNotEmpty() && nearLatest) {
+            snapshotFlow { listState.layoutInfo.totalItemsCount }
+                .first { it >= state.messages.size }
+            listState.scrollToItem(state.messages.lastIndex)
         }
     }
 
     val lastMessage = state.messages.lastOrNull()
     LaunchedEffect(lastMessage?.content) {
-        if (!initialScrollSkipped) {
-            initialScrollSkipped = true
-            return@LaunchedEffect
-        }
-        if (state.messages.isNotEmpty()) {
-            listState.animateScrollToItem(state.messages.size - 1)
+        val nearLatest = (listState.layoutInfo.visibleItemsInfo.lastOrNull()?.index ?: -1) >=
+            state.messages.lastIndex - 2
+        if (state.messages.isNotEmpty() && nearLatest) {
+            listState.scrollToItem(state.messages.lastIndex)
         }
     }
 
@@ -337,6 +341,22 @@ fun ChatRoute(
                 }
             }
 
+            if (state.messages.size > 300) {
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    horizontalArrangement = Arrangement.SpaceEvenly
+                ) {
+                    TextButton(onClick = { scrollScope.launch { listState.scrollToItem(0) } }) {
+                        Text("最早记录")
+                    }
+                    TextButton(onClick = {
+                        scrollScope.launch { listState.scrollToItem(state.messages.lastIndex) }
+                    }) {
+                        Text("最新记录")
+                    }
+                }
+            }
+
             LazyColumn(
                 modifier = Modifier
                     .weight(1f)
diff --git a/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatViewModel.kt b/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatViewModel.kt
index fe7e4bf..d0188f3 100644
--- a/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatViewModel.kt
+++ b/TKS_Bot_Android/feature/chat/src/main/java/com/krisslin/androidaiassistant/feature/chat/ChatViewModel.kt
@@ -163,7 +163,7 @@ class ChatViewModel @Inject constructor(
         viewModelScope.launch {
             // 清理历史遗留的空 bot 消息（后端旧版空回复落库的脏数据）
             runCatching { chatRepository.deleteBlankBotMessages() }
-            chatRepository.observeMessagesWithAttachments(sessionId).collect { pairs ->
+            chatRepository.observeMessagesWithAttachments(sessionId, limit = Int.MAX_VALUE).collect { pairs ->
                 val uiMessages = pairs.map { (entity, attachments) ->
                     entity.toUiModel(
                         attachments.map { att ->
